{
  "System":{
    "Application":[
      {
        "name": "Videoplayer",
        "display": {
          "name": "Video Player"
        },
        "flags": "{{flags()}}",
        "options": "{{options()}}",
        "package": "raxon/{{$this.name|>string.lowercase}}",
        "route": {
          "name": "application-video-player"
        },
        "frontend": "{{Package.Raxon.Videoplayer:Setup:install.frontend.get($this.options)}}",
        "backend": "{{Package.Raxon.Videoplayer:Setup:install.backend.get($this.options)}}",
        "directory": {
          "application": "Application/{{$this.#parentNode.#parentNode.name}}/"
        },
        "source": {
          "node": {
            "extension" : "{{config('project.dir.node')}}Data/System.Server.Extension.json",
            "content_type": "{{config('project.dir.node')}}Data/System.Server.ContentType.json"
          },
          "extension": "{{config('controller.dir.data')}}System.Server.Extension.json",
          "content_type": "{{config('controller.dir.data')}}System.Server.ContentType.json"
        },
        "method": null,
        "target": null,
        "description": "Photo viewer (Viewing jpg, png & bmp, webp)",
        "icon": "Application/{{$this.name}}/Icon/Icon.png",
        "user": "{{Package.Raxon.Videoplayer:Setup:user.list($this.flags, $this.options, $this)}}",
        "extension": "{{Package.Raxon.Videoplayer:Setup:extension.list($this.flags, $this.options, $this)}}"
      }
    ]
  }
}